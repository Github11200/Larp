# Copy to .env (never commit .env). Everything is optional for local dev:
# without keys/URLs the app falls back to stubs, an in-memory store, and an inline job queue.

# LLM via Baseten Model APIs (see server/src/lib/llm.ts). Model slugs: GET https://inference.baseten.co/v1/models
BASETEN_API_KEY=
LLM_FAST_MODEL=
LLM_SMART_MODEL=

ELEVENLABS_API_KEY=
# Optional: whisper voice id (defaults to a neutral premade voice)
ELEVENLABS_VOICE_ID=

# Unset = in-memory store (resets on restart). Set to use Postgres (e.g. the Render DB's external URL).
DATABASE_URL=
# Unset = jobs run inline in the API process. Set to use Render Key Value + the worker.
REDIS_URL=

PORT=3000
