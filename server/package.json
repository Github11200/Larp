{
  "name": "@larp/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "nudge": "tsx src/cron-nudge.ts",
    "sim": "tsx --env-file-if-exists=../.env scripts/live-sim.ts",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@larp/shared": "*",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^5.4.0",
    "postgres": "^3.4.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "vitest": "^3.0.0"
  }
}
