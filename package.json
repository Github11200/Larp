{
  "name": "larp",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "sim": "npm run sim -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright": "^1.64.1",
    "typescript": "^5.6.0"
  }
}
